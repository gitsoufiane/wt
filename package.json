{
	"name": "@gitsoufiane/wt",
	"version": "0.3.0",
	"description": "Small Git worktree helper installable as the wt command.",
	"keywords": [
		"git",
		"worktree",
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gitsoufiane/wt.git"
	},
	"license": "MIT",
	"bin": {
		"wt": "bin/wt.js"
	},
	"files": [
		"bin",
		"skills"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"format": "prettier --write \"**/*.{js,json,md}\"",
		"format:check": "prettier --check \"**/*.{js,json,md}\"",
		"lint": "eslint .",
		"test": "node --test"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"eslint": "^8.57.1",
		"prettier": "^3.8.4"
	}
}
